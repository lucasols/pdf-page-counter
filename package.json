{
  "name": "@ls-stack/pdf-page-counter",
  "version": "0.1.1",
  "description": "Count the pages of a PDF from its page tree, without parsing the whole document",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "pnpm tsc && pnpm eslint && pnpm format",
    "tsc": "tsc -p tsconfig.json",
    "tsc:watch": "tsc -p tsconfig.json --watch",
    "format": "prettier src/ tests/ --write --list-different",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "eslint": "CI=true eslint src/ tests/ --color --max-warnings=0",
    "build": "pnpm test && pnpm lint && pnpm run build:no-test",
    "build:no-test": "tsdown",
    "pre-publish": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "repository": "github:lucasols/pdf-page-counter",
  "author": "Lucas Santos",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@ls-stack/eslint-cfg": "^0.10.0",
    "@ls-stack/extended-lint": "^0.89.6",
    "@types/node": "^24.19.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "pdf-lib": "^1.17.1",
    "prettier": "3.6.2",
    "tsdown": "^0.21.10",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
